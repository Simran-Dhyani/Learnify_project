      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-pale-lilac: #E8E4F2;\n    --color-monied-gold: #D4AF37;\n    --color-deep-emerald: #046307;\n    --color-jet-black: #000000;\n    --color-stark-white: #FFFFFF;\n  }\n\n  body {\n    background-color: var(--color-pale-lilac);\n    font-family: 'DM Sans', sans-serif;\n    color: var(--color-jet-black);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-syne { font-family: 'Syne', sans-serif; }\n\n  /* Neo-Brutalist Utility */\n  .neo-border { border: 4px solid var(--color-jet-black); }\n  .neo-shadow { box-shadow: 8px 8px 0px var(--color-jet-black); }\n  .neo-shadow-sm { box-shadow: 4px 4px 0px var(--color-jet-black); }\n  .neo-shadow-lg { box-shadow: 12px 12px 0px var(--color-jet-black); }\n\n  /* Ticket Stub Shape */\n  .ticket-stub {\n    clip-path: polygon(\n      0% 20%, 5% 20%, 5% 0%, 95% 0%, 95% 20%, 100% 20%, \n      100% 80%, 95% 80%, 95% 100%, 5% 100%, 5% 80%, 0% 80%\n    );\n  }\n\n  /* Isometric Perspective */\n  .isometric-container {\n    perspective: 1000px;\n  }\n  .isometric-block {\n    transform: rotateX(25deg) rotateY(-25deg) rotateZ(10deg);\n  }\n\n  /* Marquee */\n  .marquee-content {\n    display: flex;\n    white-space: nowrap;\n    animation: marquee 20s linear infinite;\n  }\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  /* Rules background for notepad */\n  .rules-bg {\n    background-image: repeating-linear-gradient(var(--color-stark-white) 0px, var(--color-stark-white) 24px, #eee 24px, #eee 25px);\n  }\n</style>\n\n\n<nav class=\"sticky top-0 z-50 bg-(--color-pale-lilac) border-b-4 border-(--color-jet-black) px-8 py-4 flex justify-between items-center\" data-kid=\"1\">\n  <div class=\"flex items-center gap-2\" data-kid=\"2\">\n    <div class=\"w-10 h-10 bg-(--color-monied-gold) neo-border flex items-center justify-center\" data-kid=\"3\">\n      <i class=\"ti ti-brand-youtube text-2xl\" data-kid=\"4\"></i>\n    </div>\n    <span class=\"font-syne text-2xl font-bold tracking-tighter\" data-kid=\"5\">VideoTube</span>\n  </div>\n  <div class=\"hidden md:flex gap-8 font-medium\" data-kid=\"6\">\n    <a href=\"#\" class=\"hover:text-(--color-deep-emerald)\" data-kid=\"7\">Features</a>\n    <a href=\"#\" class=\"hover:text-(--color-deep-emerald)\" data-kid=\"8\">Showcase</a>\n    <a href=\"#\" class=\"hover:text-(--color-deep-emerald)\" data-kid=\"9\">Pricing</a>\n  </div>\n  <button class=\"bg-(--color-monied-gold) px-6 py-2 neo-border neo-shadow-sm font-bold hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all\" data-kid=\"10\">\n    Sign In\n  </button>\n</nav>\n\n\n<section class=\"min-h-[90vh] flex flex-col lg:flex-row items-center justify-between px-8 lg:px-24 py-16 gap-16 overflow-hidden\" data-kid=\"11\">\n  <div class=\"lg:w-1/2 z-10\" data-kid=\"12\">\n    <div class=\"flex items-center gap-2 mb-6\" data-kid=\"13\">\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/sparkles.svg\" class=\"w-8 h-8\" alt=\"sparkles\" data-kid=\"14\">\n      <span class=\"bg-(--color-monied-gold) px-4 py-1 neo-border text-sm font-bold uppercase tracking-widest\" data-kid=\"15\">The Future of Learning</span>\n    </div>\n    <h1 class=\"font-syne text-7xl lg:text-9xl leading-[0.8] font-black uppercase mb-8\" data-kid=\"16\">\n      Master <br data-kid=\"17\">\n      <span class=\"text-(--color-deep-emerald)\" data-kid=\"18\">Knowledge</span> <br data-kid=\"19\">\n      Faster.\n    </h1>\n    <p class=\"text-xl max-w-md mb-12 font-medium leading-relaxed\" data-kid=\"20\">\n      The video platform that turns watching into learning. AI-powered notes, organized workflows, and intelligent insights.\n    </p>\n    <div class=\"flex gap-6\" data-kid=\"21\">\n      <button class=\"bg-(--color-deep-emerald) text-(--color-stark-white) px-8 py-4 text-xl font-bold neo-border neo-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all\" data-kid=\"22\">\n        Start Free Trial\n      </button>\n      <button class=\"bg-(--color-stark-white) px-8 py-4 text-xl font-bold neo-border neo-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all\" data-kid=\"23\">\n        View Demo\n      </button>\n    </div>\n  </div>\n\n  <div class=\"lg:w-1/2 relative h-[600px] flex items-center justify-center isometric-container\" data-kid=\"24\">\n    \n    <div class=\"hero-block absolute top-0 right-0 w-64 h-80 bg-(--color-stark-white) neo-border neo-shadow-lg isometric-block p-4 flex flex-col gap-4\" data-kid=\"25\">\n      <div class=\"w-full h-32 bg-gray-200 rounded flex items-center justify-center\" data-kid=\"26\">\n        <i class=\"ti ti-video text-4xl text-gray-400\" data-kid=\"27\"></i>\n      </div>\n      <div class=\"h-4 w-3/4 bg-gray-100\" data-kid=\"28\"></div>\n      <div class=\"h-4 w-1/2 bg-gray-100\" data-kid=\"29\"></div>\n      <div class=\"mt-auto h-8 w-full bg-(--color-monied-gold) neo-border\" data-kid=\"30\"></div>\n    </div>\n    \n    <div class=\"hero-block absolute bottom-12 left-0 w-72 h-48 bg-(--color-monied-gold) neo-border neo-shadow-lg isometric-block p-6 flex items-center gap-4\" data-kid=\"31\">\n      <div class=\"w-16 h-16 rounded-full bg-(--color-stark-white) neo-border flex items-center justify-center\" data-kid=\"32\">\n        <i class=\"ti ti-brain text-3xl\" data-kid=\"33\"></i>\n      </div>\n      <div data-kid=\"34\">\n        <div class=\"text-sm font-black uppercase\" data-kid=\"35\">AI Analysis</div>\n        <div class=\"text-xs font-medium\" data-kid=\"36\">Extracting 42 key insights...</div>\n      </div>\n    </div>\n\n    <div class=\"hero-block absolute top-1/4 left-1/4 w-56 h-56 bg-(--color-stark-white) neo-border neo-shadow-lg isometric-block p-4\" data-kid=\"37\">\n      <div class=\"flex justify-between mb-4\" data-kid=\"38\">\n        <div class=\"w-3 h-3 rounded-full bg-red-400\" data-kid=\"39\"></div>\n        <div class=\"w-3 h-3 rounded-full bg-yellow-400\" data-kid=\"40\"></div>\n        <div class=\"w-3 h-3 rounded-full bg-green-400\" data-kid=\"41\"></div>\n      </div>\n      <div class=\"space-y-2\" data-kid=\"42\">\n        <div class=\"h-2 w-full bg-gray-100\" data-kid=\"43\"></div>\n        <div class=\"h-2 w-full bg-gray-100\" data-kid=\"44\"></div>\n        <div class=\"h-2 w-3/4 bg-gray-100\" data-kid=\"45\"></div>\n        <div class=\"h-2 w-full bg-gray-100\" data-kid=\"46\"></div>\n      </div>\n    </div>\n\n    \n    <img src=\"https://images.unsplash.com/photo-1622547748225-3fc4abd2cca0?auto=format&w=600&q=80&fit=crop\" class=\"hero-block absolute -bottom-10 -right-10 w-48 h-48 object-cover neo-border neo-shadow opacity-50\" alt=\"abstract shape\" data-kid=\"47\">\n  </div>\n</section>\n\n\n<section class=\"px-8 lg:px-24 py-24\" data-kid=\"48\">\n  <h2 class=\"font-syne text-5xl font-black uppercase mb-16 flex items-center gap-4\" data-kid=\"49\">\n    Built for <span class=\"text-(--color-monied-gold)\" data-kid=\"50\">Deep</span> Learning\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/star-swirl.svg\" class=\"w-12 h-12\" style=\"filter: invert(1);\" alt=\"starburst\" data-kid=\"51\">\n  </h2>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 h-auto lg:h-[800px]\" data-kid=\"52\">\n    \n    <div class=\"md:col-span-8 bg-(--color-stark-white) neo-border neo-shadow p-8 flex flex-col\" data-kid=\"53\">\n      <div class=\"flex justify-between items-start mb-8\" data-kid=\"54\">\n        <div data-kid=\"55\">\n          <h3 class=\"font-syne text-3xl font-black uppercase\" data-kid=\"56\">01. Intelligent Player</h3>\n          <p class=\"font-medium text-lg mt-2\" data-kid=\"57\">Interact with your video content in real-time.</p>\n        </div>\n        <div class=\"w-20 h-20 bg-(--color-monied-gold) neo-border flex items-center justify-center rounded-full hover:scale-110 transition-transform cursor-pointer\" data-kid=\"58\">\n          <i class=\"ti ti-player-play-filled text-4xl\" data-kid=\"59\"></i>\n        </div>\n      </div>\n      <div class=\"flex-grow w-full bg-gray-900 neo-border relative overflow-hidden\" data-kid=\"60\">\n        <img src=\"https://images.unsplash.com/photo-1720962158789-9389a4f399da?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-60\" alt=\"player interface\" data-kid=\"61\">\n        <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"62\">\n           <div class=\"bg-(--color-stark-white)/10 backdrop-blur-md p-6 neo-border neo-shadow-sm max-w-md\" data-kid=\"63\">\n             <div class=\"text-(--color-monied-gold) font-bold mb-2 uppercase text-xs\" data-kid=\"64\">AI Insight @ 04:22</div>\n             <p class=\"text-(--color-stark-white) text-sm font-medium\" data-kid=\"65\">The key concept here is the intersection of architecture and fluid dynamics...</p>\n           </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"md:col-span-4 bg-(--color-stark-white) neo-border neo-shadow rules-bg p-8 flex flex-col\" data-kid=\"66\">\n      <div class=\"flex items-center gap-3 mb-6\" data-kid=\"67\">\n        <i class=\"ti ti-notebook text-3xl\" data-kid=\"68\"></i>\n        <h3 class=\"font-syne text-3xl font-black uppercase\" data-kid=\"69\">02. Smart Notes</h3>\n      </div>\n      <div class=\"space-y-6 flex-grow\" data-kid=\"70\">\n        <div class=\"border-b-2 border-gray-200 pb-2\" data-kid=\"71\">\n          <p class=\"font-bold text-gray-400 text-xs mb-1 uppercase tracking-widest\" data-kid=\"72\">Today, 10:45 AM</p>\n          <p class=\"font-medium\" data-kid=\"73\">Summary: The Edwardian era was characterized by its rigid social hierarchy and opulent artistic expressions.</p>\n        </div>\n        <div class=\"border-b-2 border-gray-200 pb-2\" data-kid=\"74\">\n          <p class=\"font-bold text-gray-400 text-xs mb-1 uppercase tracking-widest\" data-kid=\"75\">Today, 10:47 AM</p>\n          <p class=\"font-medium\" data-kid=\"76\">Key Term: <span class=\"bg-(--color-monied-gold) px-1\" data-kid=\"77\">Monied Aesthetic</span></p>\n        </div>\n        <div class=\"border-b-2 border-gray-200 pb-2\" data-kid=\"78\">\n          <p class=\"font-bold text-gray-400 text-xs mb-1 uppercase tracking-widest\" data-kid=\"79\">Today, 11:02 AM</p>\n          <p class=\"font-medium italic\" data-kid=\"80\">\"Learning is the only thing the mind never exhausts, never fears, and never regrets.\"</p>\n        </div>\n      </div>\n      <div class=\"mt-8\" data-kid=\"81\">\n        <div class=\"h-12 w-full bg-(--color-jet-black) text-(--color-stark-white) flex items-center px-4 font-bold neo-border\" data-kid=\"82\">\n          Type a note...\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"md:col-span-12 bg-(--color-monied-gold) neo-border neo-shadow p-8 flex flex-col md:flex-row gap-12\" data-kid=\"83\">\n      <div class=\"md:w-1/3\" data-kid=\"84\">\n        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"85\">\n          <i class=\"ti ti-folder text-3xl\" data-kid=\"86\"></i>\n          <h3 class=\"font-syne text-3xl font-black uppercase\" data-kid=\"87\">03. Vault</h3>\n        </div>\n        <p class=\"font-medium text-lg mb-8\" data-kid=\"88\">Organize your research, lectures, and discoveries into intelligent workspaces.</p>\n        <div class=\"flex flex-col gap-4\" data-kid=\"89\">\n          <div class=\"bg-(--color-stark-white) neo-border p-4 neo-shadow-sm flex items-center justify-between font-bold\" data-kid=\"90\">\n            <span data-kid=\"91\">Design Theory</span>\n            <span class=\"bg-gray-100 px-2 text-xs\" data-kid=\"92\">12 Videos</span>\n          </div>\n          <div class=\"bg-(--color-stark-white) neo-border p-4 neo-shadow-sm flex items-center justify-between font-bold border-l-8 border-l-(--color-deep-emerald)\" data-kid=\"93\">\n            <span data-kid=\"94\">Art History</span>\n            <span class=\"bg-gray-100 px-2 text-xs\" data-kid=\"95\">8 Videos</span>\n          </div>\n          <div class=\"bg-(--color-stark-white) neo-border p-4 neo-shadow-sm flex items-center justify-between font-bold opacity-70\" data-kid=\"96\">\n            <span data-kid=\"97\">Philosophy</span>\n            <span class=\"bg-gray-100 px-2 text-xs\" data-kid=\"98\">24 Videos</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"md:w-2/3 grid grid-cols-2 lg:grid-cols-3 gap-6\" data-kid=\"99\">\n        <div class=\"aspect-square bg-(--color-stark-white) neo-border neo-shadow-sm relative overflow-hidden group cursor-pointer\" data-kid=\"100\">\n           <img src=\"https://images.unsplash.com/photo-1757484965213-8393e82789fe?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" alt=\"thumbnail\" data-kid=\"101\">\n           <div class=\"absolute bottom-0 left-0 right-0 bg-(--color-jet-black) text-(--color-stark-white) text-[10px] p-2 font-bold uppercase\" data-kid=\"102\">Abstract Forms I</div>\n        </div>\n        <div class=\"aspect-square bg-(--color-stark-white) neo-border neo-shadow-sm relative overflow-hidden group cursor-pointer\" data-kid=\"103\">\n           <img src=\"https://images.unsplash.com/photo-1725544014976-5c60cc9fc1fd?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" alt=\"thumbnail\" data-kid=\"104\">\n           <div class=\"absolute bottom-0 left-0 right-0 bg-(--color-jet-black) text-(--color-stark-white) text-[10px] p-2 font-bold uppercase\" data-kid=\"105\">Modern Brutalism</div>\n        </div>\n        <div class=\"aspect-square bg-(--color-stark-white) neo-border neo-shadow-sm relative overflow-hidden group cursor-pointer\" data-kid=\"106\">\n           <img src=\"https://images.unsplash.com/photo-1651421569876-f74b6a70b9b2?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" alt=\"thumbnail\" data-kid=\"107\">\n           <div class=\"absolute bottom-0 left-0 right-0 bg-(--color-jet-black) text-(--color-stark-white) text-[10px] p-2 font-bold uppercase\" data-kid=\"108\">Urban Dynamics</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"bg-(--color-deep-emerald) py-24 border-y-8 border-(--color-jet-black) overflow-hidden\" data-kid=\"109\">\n  <div class=\"bg-(--color-monied-gold) border-y-4 border-(--color-jet-black) py-4 overflow-hidden mb-24\" data-kid=\"110\">\n    <div class=\"marquee-content font-syne text-6xl font-black uppercase tracking-tighter\" data-kid=\"111\">\n      <span data-kid=\"112\">AI ASSISTED LEARNING • INTELLIGENT INSIGHTS • AUTOMATED SUMMARY • NEURAL TRANSCRIPTION • </span>\n      <span data-kid=\"113\">AI ASSISTED LEARNING • INTELLIGENT INSIGHTS • AUTOMATED SUMMARY • NEURAL TRANSCRIPTION • </span>\n    </div>\n  </div>\n\n  <div class=\"container mx-auto px-8 flex flex-col lg:flex-row items-center gap-24\" data-kid=\"114\">\n    <div class=\"lg:w-1/2\" data-kid=\"115\">\n      <h2 class=\"font-syne text-6xl lg:text-8xl text-(--color-stark-white) font-black uppercase mb-8\" data-kid=\"116\">\n        Your Personal <span class=\"text-(--color-monied-gold)\" data-kid=\"117\">Knowledge</span> Assistant\n      </h2>\n      <p class=\"text-(--color-stark-white) text-xl font-medium mb-12 opacity-80\" data-kid=\"118\">\n        Our proprietary AI models process your videos to extract the most relevant information, allowing you to ask questions and get instant, accurate answers.\n      </p>\n      <div class=\"flex items-center gap-6\" data-kid=\"119\">\n         <div class=\"w-16 h-16 bg-(--color-monied-gold) neo-border neo-shadow-sm flex items-center justify-center\" data-kid=\"120\">\n            <i class=\"ti ti-robot text-3xl\" data-kid=\"121\"></i>\n         </div>\n         <span class=\"text-(--color-stark-white) font-bold text-2xl uppercase italic\" data-kid=\"122\">Powered by VideoBrain AI</span>\n      </div>\n    </div>\n\n    <div class=\"lg:w-1/2 w-full\" data-kid=\"123\">\n      <div class=\"bg-(--color-stark-white) neo-border neo-shadow-lg p-10 relative\" data-kid=\"124\">\n        <div class=\"flex items-center gap-2 mb-8\" data-kid=\"125\">\n           <div class=\"w-3 h-3 rounded-full bg-red-500\" data-kid=\"126\"></div>\n           <div class=\"w-3 h-3 rounded-full bg-yellow-500\" data-kid=\"127\"></div>\n           <div class=\"w-3 h-3 rounded-full bg-green-500\" data-kid=\"128\"></div>\n           <span class=\"ml-4 font-bold uppercase text-xs tracking-widest text-gray-400\" data-kid=\"129\">Terminal Output</span>\n        </div>\n        <div class=\"font-mono text-lg space-y-6\" data-kid=\"130\">\n          <div class=\"flex gap-4\" data-kid=\"131\">\n            <span class=\"text-blue-600 font-bold\" data-kid=\"132\">></span>\n            <span class=\"font-bold\" data-kid=\"133\">Explain the concept of 'Monied Edwardian'.</span>\n          </div>\n          <div class=\"flex gap-4\" data-kid=\"134\">\n            <span class=\"text-(--color-deep-emerald) font-bold\" data-kid=\"135\">_</span>\n            <p class=\"ai-typing-text leading-relaxed font-bold\" data-kid=\"136\"></p>\n          </div>\n        </div>\n        <div class=\"absolute -right-8 -top-8 w-16 h-16 bg-(--color-monied-gold) neo-border rotate-12 flex items-center justify-center\" data-kid=\"137\">\n           <i class=\"ti ti-sparkles text-2xl\" data-kid=\"138\"></i>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"py-32 px-8 flex flex-col items-center text-center\" data-kid=\"139\">\n  <div class=\"mb-12\" data-kid=\"140\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/star-swirl.svg\" class=\"w-24 h-24 mx-auto mb-8 animate-spin-slow\" style=\"filter: invert(1); animation-duration: 10s;\" alt=\"star\" data-kid=\"141\">\n    <h2 class=\"font-syne text-6xl lg:text-8xl font-black uppercase mb-8\" data-kid=\"142\">\n      The Journey <br data-kid=\"143\">\n      <span class=\"text-(--color-deep-emerald)\" data-kid=\"144\">Starts Here.</span>\n    </h2>\n    <p class=\"text-2xl font-medium max-w-2xl mx-auto mb-16\" data-kid=\"145\">\n      Join over 500,000 learners who are transforming their video experience today.\n    </p>\n  </div>\n\n  <button class=\"ticket-stub bg-(--color-monied-gold) hover:bg-black hover:text-white transition-colors px-16 py-8 text-4xl font-black font-syne uppercase border-4 border-black neo-shadow-lg group\" data-kid=\"146\">\n    <span class=\"flex items-center gap-4 group-hover:scale-105 transition-transform\" data-kid=\"147\">\n      Claim Your Free Account\n      <i class=\"ti ti-arrow-right\" data-kid=\"148\"></i>\n    </span>\n  </button>\n  \n  <p class=\"mt-8 font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"149\">No credit card required • Unlimited access for 14 days</p>\n</section>\n\n\n<footer class=\"bg-(--color-jet-black) text-(--color-stark-white) px-8 lg:px-24 py-16\" data-kid=\"150\">\n  <div class=\"flex flex-col md:flex-row justify-between items-start gap-12 border-b-2 border-white/10 pb-16\" data-kid=\"151\">\n    <div class=\"max-w-xs\" data-kid=\"152\">\n      <div class=\"flex items-center gap-2 mb-6\" data-kid=\"153\">\n        <div class=\"w-10 h-10 bg-(--color-monied-gold) flex items-center justify-center text-(--color-jet-black)\" data-kid=\"154\">\n          <i class=\"ti ti-brand-youtube text-2xl\" data-kid=\"155\"></i>\n        </div>\n        <span class=\"font-syne text-2xl font-bold\" data-kid=\"156\">VideoTube</span>\n      </div>\n      <p class=\"opacity-60 font-medium\" data-kid=\"157\">Elevating human intelligence through video-centric deep learning workflows.</p>\n    </div>\n    <div class=\"grid grid-cols-2 lg:grid-cols-3 gap-16\" data-kid=\"158\">\n      <div class=\"flex flex-col gap-4\" data-kid=\"159\">\n        <h4 class=\"font-syne font-black uppercase text-xs tracking-widest text-(--color-monied-gold)\" data-kid=\"160\">Product</h4>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"161\">Video Player</a>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"162\">Smart Notes</a>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"163\">AI Analysis</a>\n      </div>\n      <div class=\"flex flex-col gap-4\" data-kid=\"164\">\n        <h4 class=\"font-syne font-black uppercase text-xs tracking-widest text-(--color-monied-gold)\" data-kid=\"165\">Resources</h4>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"166\">Documentation</a>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"167\">API Reference</a>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"168\">Community</a>\n      </div>\n      <div class=\"flex flex-col gap-4\" data-kid=\"169\">\n        <h4 class=\"font-syne font-black uppercase text-xs tracking-widest text-(--color-monied-gold)\" data-kid=\"170\">Company</h4>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"171\">About Us</a>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"172\">Careers</a>\n        <a href=\"#\" class=\"opacity-60 hover:opacity-100\" data-kid=\"173\">Contact</a>\n      </div>\n    </div>\n  </div>\n  <div class=\"mt-8 flex flex-col md:flex-row justify-between items-center opacity-40 text-sm font-bold uppercase tracking-widest\" data-kid=\"174\">\n    <p data-kid=\"175\">&copy; 2026 VideoTube Labs. All rights reserved.</p>\n    <div class=\"flex gap-8 mt-4 md:mt-0\" data-kid=\"176\">\n      <a href=\"#\" data-kid=\"177\">Privacy</a>\n      <a href=\"#\" data-kid=\"178\">Terms</a>\n      <a href=\"#\" data-kid=\"179\">Security</a>\n    </div>\n  </div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"180\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"181\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/TextPlugin.min.js\" data-kid=\"182\"></script>\n<script data-kid=\"183\">\n  gsap.registerPlugin(ScrollTrigger, TextPlugin);\n\n  // Hero Bobbing Animation\n  gsap.to(\".hero-block\", {\n    y: \"-=30\",\n    duration: 3,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\",\n    stagger: {\n      each: 0.5,\n      from: \"random\"\n    }\n  });\n\n  // AI Typing Animation\n  const aiResponses = [\n    \"Monied Edwardian refers to the opulent, structured aesthetic of the early 20th century, characterized by rich materials and classical proportions.\",\n    \"VideoTube leverages these timeless principles of organization and hierarchy to create a superior learning environment for modern students.\",\n    \"Our AI is ready to analyze your content. Simply paste a link to begin the knowledge extraction process.\"\n  ];\n  \n  let currentResponseIndex = 0;\n  \n  function typeNextResponse() {\n    gsap.to(\".ai-typing-text\", {\n      duration: 3,\n      text: aiResponses[currentResponseIndex],\n      ease: \"none\",\n      onComplete: () => {\n        gsap.delayedCall(2, () => {\n          currentResponseIndex = (currentResponseIndex + 1) % aiResponses.length;\n          typeNextResponse();\n        });\n      }\n    });\n  }\n  \n  typeNextResponse();\n\n  // Scroll Animations for Feature Grid\n  gsap.from(\".neo-border\", {\n    scrollTrigger: {\n      trigger: \".grid\",\n      start: \"top 80%\",\n    },\n    opacity: 0,\n    y: 50,\n    duration: 1,\n    stagger: 0.1,\n    ease: \"power3.out\"\n  });\n\n  // Marquee Speed Sync (Optional: adjust speed on scroll)\n  ScrollTrigger.create({\n    trigger: \".marquee-content\",\n    start: \"top bottom\",\n    end: \"bottom top\",\n    onUpdate: (self) => {\n      // Logic for dynamic marquee speed if needed\n    }\n  });\n</script>",
