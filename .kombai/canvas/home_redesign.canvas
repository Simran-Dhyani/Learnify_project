      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Roboto+Mono:wght@400;500&family=Dancing+Script:wght@400;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-serif { font-family: 'Playfair Display', serif; }\n  .font-mono { font-family: 'Roboto Mono', monospace; }\n  .font-cursive { font-family: 'Dancing Script', cursive; }\n\n  /* Custom grid lines for Swiss aesthetic */\n  .swiss-grid-border {\n    border-color: #111111;\n    border-width: 2px;\n  }\n\n  /* Marquee animation */\n  .marquee-container {\n    overflow: hidden;\n    white-space: nowrap;\n    display: flex;\n  }\n  \n  .marquee-content {\n    display: flex;\n    min-width: 100%;\n  }\n\n  /* Custom Pill Clip for Hero */\n  .pill-mask {\n    clip-path: inset(0 0 0 0 round 9999px);\n  }\n\n  /* Accordion Folder Effect */\n  .folder-item {\n    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n    flex: 1;\n    overflow: hidden;\n  }\n  .folder-item:hover {\n    flex: 3;\n  }\n</style>\n\n<div class=\"bg-[#F9F6F0] text-[#111111] min-h-screen selection:bg-[#E05A47] selection:text-white\" data-kid=\"1\">\n  \n  \n  <nav class=\"swiss-grid-border border-b flex items-center justify-between px-8 py-4 font-mono sticky top-0 bg-[#F9F6F0] z-50\" data-kid=\"2\">\n    <div class=\"text-2xl font-bold tracking-tighter\" data-kid=\"3\">VIDEOTUBE</div>\n    <div class=\"flex gap-12 text-sm uppercase font-medium\" data-kid=\"4\">\n      <a href=\"#\" class=\"hover:text-[#E05A47]\" data-kid=\"5\">Features</a>\n      <a href=\"#\" class=\"hover:text-[#E05A47]\" data-kid=\"6\">Learn</a>\n      <a href=\"#\" class=\"hover:text-[#E05A47]\" data-kid=\"7\">Library</a>\n    </div>\n    <div class=\"flex gap-4\" data-kid=\"8\">\n      <button class=\"swiss-grid-border border px-6 py-2 hover:bg-[#111111] hover:text-[#F9F6F0] transition-colors uppercase text-xs font-bold\" data-kid=\"9\">Sign In</button>\n      <button class=\"bg-[#E05A47] text-white px-6 py-2 hover:bg-[#111111] transition-colors uppercase text-xs font-bold\" data-kid=\"10\">Get Started</button>\n    </div>\n  </nav>\n\n  \n  <section class=\"grid grid-cols-1 md:grid-cols-2 min-h-[90vh]\" data-kid=\"11\">\n    \n    <div class=\"swiss-grid-border border-r p-12 flex flex-col justify-center\" data-kid=\"12\">\n      <div class=\"font-mono text-sm uppercase mb-8 flex items-center gap-2\" data-kid=\"13\">\n        <span class=\"w-2 h-2 bg-[#E05A47] rounded-full\" data-kid=\"14\"></span>\n        The Future of Knowledge\n      </div>\n      <h1 class=\"font-serif text-[120px] leading-[0.9] tracking-tighter mb-12 italic\" data-kid=\"15\">\n        Learn.<br data-kid=\"16\">Evolve.\n      </h1>\n      <p class=\"font-mono text-lg max-w-md leading-relaxed mb-12\" data-kid=\"17\">\n        A clinical approach to digital learning. Smart notes, organized video paths, and AI-driven insights integrated into a single editorial interface.\n      </p>\n      <div class=\"flex gap-4\" data-kid=\"18\">\n        <a href=\"#\" class=\"swiss-grid-border border p-8 flex-1 flex items-center justify-between hover:bg-[#E05A47] hover:text-white transition-all group\" data-kid=\"19\">\n          <span class=\"font-serif text-2xl\" data-kid=\"20\">Start Learning</span>\n          <i class=\"ti ti-arrow-right text-3xl transition-transform group-hover:translate-x-2\" data-kid=\"21\"></i>\n        </a>\n      </div>\n    </div>\n\n    \n    <div class=\"p-12 flex items-center justify-center relative overflow-hidden\" data-kid=\"22\">\n      <div class=\"absolute inset-0 opacity-5 pointer-events-none\" data-kid=\"23\">\n        <img src=\"https://images.unsplash.com/photo-1759661030840-76b6217c9c80?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale\" loading=\"lazy\" decoding=\"async\" data-kid=\"24\">\n      </div>\n      <div class=\"w-full h-full max-h-[700px] aspect-[4/5] bg-[#111111] pill-mask shadow-2xl relative z-10 overflow-hidden\" data-kid=\"25\">\n        <video src=\"https://videos.pexels.com/video-files/6281082/6281082-sd_426_240_24fps.mp4\" poster=\"https://images.pexels.com/videos/6281082/afro-hair-architect-architectural-architectural-building-6281082.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover grayscale brightness-75 hover:grayscale-0 transition-all duration-1000\" data-kid=\"26\"></video>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"swiss-grid-border border-y py-6 overflow-hidden bg-[#111111] text-[#F9F6F0]\" data-kid=\"27\">\n    <div id=\"marquee\" class=\"marquee-container font-mono uppercase text-2xl font-medium tracking-widest\" data-kid=\"28\">\n      <div class=\"marquee-content gap-12 items-center\" data-kid=\"29\">\n        <span data-kid=\"30\">AI-Powered Insights</span> <i class=\"ti ti-asterisk\" data-kid=\"31\"></i>\n        <span data-kid=\"32\">Smart Note Taking</span> <i class=\"ti ti-asterisk\" data-kid=\"33\"></i>\n        <span data-kid=\"34\">Organized Library</span> <i class=\"ti ti-asterisk\" data-kid=\"35\"></i>\n        <span data-kid=\"36\">Video Learning Evolution</span> <i class=\"ti ti-asterisk\" data-kid=\"37\"></i>\n        <span data-kid=\"38\">Editorial Design</span> <i class=\"ti ti-asterisk\" data-kid=\"39\"></i>\n        <span data-kid=\"40\">AI-Powered Insights</span> <i class=\"ti ti-asterisk\" data-kid=\"41\"></i>\n        <span data-kid=\"42\">Smart Note Taking</span> <i class=\"ti ti-asterisk\" data-kid=\"43\"></i>\n        <span data-kid=\"44\">Organized Library</span> <i class=\"ti ti-asterisk\" data-kid=\"45\"></i>\n        <span data-kid=\"46\">Video Learning Evolution</span> <i class=\"ti ti-asterisk\" data-kid=\"47\"></i>\n        <span data-kid=\"48\">Editorial Design</span> <i class=\"ti ti-asterisk\" data-kid=\"49\"></i>\n      </div>\n    </div>\n  </div>\n\n  \n  <section class=\"flex flex-col md:flex-row swiss-grid-border border-b min-h-screen\" data-kid=\"50\">\n    \n    <div class=\"w-full md:w-1/2 swiss-grid-border border-r sticky top-20 h-[calc(100vh-80px)] p-12 flex items-center justify-center bg-[#111111] overflow-hidden\" data-kid=\"51\">\n      <div class=\"absolute inset-0 opacity-40\" data-kid=\"52\">\n        <img src=\"https://images.unsplash.com/photo-1759661030840-76b6217c9c80?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale\" loading=\"lazy\" decoding=\"async\" data-kid=\"53\">\n      </div>\n      <div class=\"relative z-10 text-center\" data-kid=\"54\">\n        <div id=\"feature-illustration\" class=\"text-[#F9F6F0] font-serif text-[200px] leading-none opacity-10\" data-kid=\"55\">01</div>\n        <p class=\"text-white font-mono mt-4 uppercase tracking-[0.2em] text-sm\" data-kid=\"56\">Systemic Learning Architecture</p>\n      </div>\n    </div>\n\n    \n    <div class=\"w-full md:w-1/2\" data-kid=\"57\">\n      \n      <div class=\"p-16 swiss-grid-border border-b min-h-[50vh] flex flex-col justify-center\" data-kid=\"58\">\n        <span class=\"font-mono text-6xl mb-8 block opacity-20\" data-kid=\"59\">01</span>\n        <h3 class=\"font-serif text-5xl mb-8 flex items-center gap-4\" data-kid=\"60\">\n          <i class=\"ti ti-book-2 text-[#E05A47]\" data-kid=\"61\"></i>\n          Smart Notes\n        </h3>\n        <p class=\"font-mono text-lg leading-relaxed text-gray-700\" data-kid=\"62\">\n          Transform video consumption into knowledge production. Our AI extracts core concepts and creates structured notes that follow the logic of your curriculum. Annotated with precision, exported with ease.\n        </p>\n        <div class=\"mt-12 flex gap-2\" data-kid=\"63\">\n          <span class=\"bg-[#111111] text-white px-3 py-1 font-mono text-xs uppercase\" data-kid=\"64\">Extraction</span>\n          <span class=\"bg-[#111111] text-white px-3 py-1 font-mono text-xs uppercase\" data-kid=\"65\">Analysis</span>\n          <span class=\"bg-[#111111] text-white px-3 py-1 font-mono text-xs uppercase\" data-kid=\"66\">Structure</span>\n        </div>\n      </div>\n\n      \n      <div class=\"p-16 swiss-grid-border border-b min-h-[50vh] flex flex-col justify-center\" data-kid=\"67\">\n        <span class=\"font-mono text-6xl mb-8 block opacity-20\" data-kid=\"68\">02</span>\n        <h3 class=\"font-serif text-5xl mb-8 flex items-center gap-4\" data-kid=\"69\">\n          <i class=\"ti ti-pencil text-[#E05A47]\" data-kid=\"70\"></i>\n          Interactive Learning\n        </h3>\n        <p class=\"font-mono text-lg leading-relaxed text-gray-700\" data-kid=\"71\">\n          Not just watching, but interacting. Engage with video content through dynamic breakpoints, integrated quizzes, and cross-reference citations within your personal library.\n        </p>\n      </div>\n\n      \n      <div class=\"p-16 min-h-[50vh] flex flex-col justify-center\" data-kid=\"72\">\n        <span class=\"font-mono text-6xl mb-8 block opacity-20\" data-kid=\"73\">03</span>\n        <h3 class=\"font-serif text-5xl mb-8 flex items-center gap-4\" data-kid=\"74\">\n          <i class=\"ti ti-folders text-[#E05A47]\" data-kid=\"75\"></i>\n          Archive Management\n        </h3>\n        <p class=\"font-mono text-lg leading-relaxed text-gray-700\" data-kid=\"76\">\n          A filing cabinet for the mind. Organize your video courses into curated folders that mimic a high-end physical archive. Visual hierarchy meets digital efficiency.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"swiss-grid-border border-b p-12 bg-[#111111] text-white\" data-kid=\"77\">\n    <div class=\"mb-12\" data-kid=\"78\">\n      <h2 class=\"font-serif text-6xl italic mb-4\" data-kid=\"79\">The Archive.</h2>\n      <p class=\"font-mono text-sm uppercase text-[#8BA888]\" data-kid=\"80\">Curated Folders for Professional Development</p>\n    </div>\n    \n    <div class=\"flex h-[500px] gap-2\" data-kid=\"81\">\n      \n      <div class=\"folder-item bg-[#1A1A1E] swiss-grid-border border-white/10 border flex flex-col group relative\" data-kid=\"82\">\n        <img src=\"https://images.pexels.com/photos/1370294/pexels-photo-1370294.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\" class=\"absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-40 transition-opacity\" loading=\"lazy\" decoding=\"async\" data-kid=\"83\">\n        <div class=\"p-6 relative z-10 h-full flex flex-col justify-between\" data-kid=\"84\">\n          <div class=\"font-mono text-xs opacity-50\" data-kid=\"85\">VOL. 01</div>\n          <div class=\"rotate-[-90deg] origin-left whitespace-nowrap translate-y-[200px] group-hover:rotate-0 group-hover:translate-y-0 transition-all duration-500\" data-kid=\"86\">\n            <h4 class=\"font-serif text-3xl mb-2\" data-kid=\"87\">Web Development</h4>\n            <p class=\"font-mono text-xs uppercase text-[#E05A47]\" data-kid=\"88\">12 Modules</p>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"folder-item bg-[#1A1A1E] swiss-grid-border border-white/10 border flex flex-col group relative\" data-kid=\"89\">\n        <img src=\"https://images.pexels.com/photos/3137073/pexels-photo-3137073.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\" class=\"absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-40 transition-opacity\" loading=\"lazy\" decoding=\"async\" data-kid=\"90\">\n        <div class=\"p-6 relative z-10 h-full flex flex-col justify-between\" data-kid=\"91\">\n          <div class=\"font-mono text-xs opacity-50\" data-kid=\"92\">VOL. 02</div>\n          <div class=\"rotate-[-90deg] origin-left whitespace-nowrap translate-y-[200px] group-hover:rotate-0 group-hover:translate-y-0 transition-all duration-500\" data-kid=\"93\">\n            <h4 class=\"font-serif text-3xl mb-2\" data-kid=\"94\">Design Theory</h4>\n            <p class=\"font-mono text-xs uppercase text-[#E05A47]\" data-kid=\"95\">08 Modules</p>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"folder-item bg-[#1A1A1E] swiss-grid-border border-white/10 border flex flex-col group relative\" data-kid=\"96\">\n        <img src=\"https://images.pexels.com/photos/17596610/pexels-photo-17596610.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\" class=\"absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-40 transition-opacity\" loading=\"lazy\" decoding=\"async\" data-kid=\"97\">\n        <div class=\"p-6 relative z-10 h-full flex flex-col justify-between\" data-kid=\"98\">\n          <div class=\"font-mono text-xs opacity-50\" data-kid=\"99\">VOL. 03</div>\n          <div class=\"rotate-[-90deg] origin-left whitespace-nowrap translate-y-[200px] group-hover:rotate-0 group-hover:translate-y-0 transition-all duration-500\" data-kid=\"100\">\n            <h4 class=\"font-serif text-3xl mb-2\" data-kid=\"101\">Machine Learning</h4>\n            <p class=\"font-mono text-xs uppercase text-[#E05A47]\" data-kid=\"102\">15 Modules</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4\" data-kid=\"103\">\n    <div class=\"aspect-square p-8 bg-[#111111] text-[#F9F6F0] flex flex-col justify-between\" data-kid=\"104\">\n      <i class=\"ti ti-quote text-4xl\" data-kid=\"105\"></i>\n      <p class=\"font-cursive text-3xl leading-snug\" data-kid=\"106\">\"The most intellectual way to consume video content I've found.\"</p>\n      <div class=\"font-mono text-xs\" data-kid=\"107\">— Alex Rivera, Architect</div>\n    </div>\n    <div class=\"aspect-square p-8 bg-[#E05A47] text-white flex flex-col justify-between\" data-kid=\"108\">\n      <i class=\"ti ti-quote text-4xl\" data-kid=\"109\"></i>\n      <p class=\"font-cursive text-3xl leading-snug\" data-kid=\"110\">\"Finally, a learning platform that respects the design process.\"</p>\n      <div class=\"font-mono text-xs\" data-kid=\"111\">— Sarah Chen, Senior Designer</div>\n    </div>\n    <div class=\"aspect-square p-8 bg-[#111111] text-[#F9F6F0] flex flex-col justify-between\" data-kid=\"112\">\n      <i class=\"ti ti-quote text-4xl\" data-kid=\"113\"></i>\n      <p class=\"font-cursive text-3xl leading-snug\" data-kid=\"114\">\"The smart notes feature saved me weeks of manual transcription.\"</p>\n      <div class=\"font-mono text-xs\" data-kid=\"115\">— James Miller, Researcher</div>\n    </div>\n    <div class=\"aspect-square p-8 bg-[#8BA888] text-[#111111] flex flex-col justify-between\" data-kid=\"116\">\n      <i class=\"ti ti-quote text-4xl\" data-kid=\"117\"></i>\n      <p class=\"font-cursive text-3xl leading-snug\" data-kid=\"118\">\"Structure meets speed. VideoTube is my daily driver.\"</p>\n      <div class=\"font-mono text-xs\" data-kid=\"119\">— Emily Watts, Developer</div>\n    </div>\n  </section>\n\n  \n  <footer class=\"p-12 swiss-grid-border border-t\" data-kid=\"120\">\n    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-12 mb-20\" data-kid=\"121\">\n      <div class=\"col-span-2\" data-kid=\"122\">\n        <h2 class=\"font-serif text-7xl italic mb-8\" data-kid=\"123\">VideoTube.</h2>\n        <p class=\"font-mono text-sm max-w-sm uppercase tracking-widest opacity-60\" data-kid=\"124\">The systematic evolution of digital pedagogy.</p>\n      </div>\n      <div data-kid=\"125\">\n        <h5 class=\"font-mono font-bold uppercase text-xs mb-6 text-[#E05A47]\" data-kid=\"126\">Index</h5>\n        <ul class=\"font-mono text-sm space-y-2 uppercase\" data-kid=\"127\">\n          <li data-kid=\"128\"><a href=\"#\" class=\"hover:underline\" data-kid=\"129\">Home</a></li>\n          <li data-kid=\"130\"><a href=\"#\" class=\"hover:underline\" data-kid=\"131\">Research</a></li>\n          <li data-kid=\"132\"><a href=\"#\" class=\"hover:underline\" data-kid=\"133\">Archive</a></li>\n          <li data-kid=\"134\"><a href=\"#\" class=\"hover:underline\" data-kid=\"135\">Ethics</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"136\">\n        <h5 class=\"font-mono font-bold uppercase text-xs mb-6 text-[#E05A47]\" data-kid=\"137\">Contact</h5>\n        <ul class=\"font-mono text-sm space-y-2 uppercase\" data-kid=\"138\">\n          <li data-kid=\"139\"><a href=\"#\" class=\"hover:underline\" data-kid=\"140\">Twitter</a></li>\n          <li data-kid=\"141\"><a href=\"#\" class=\"hover:underline\" data-kid=\"142\">Email</a></li>\n          <li data-kid=\"143\"><a href=\"#\" class=\"hover:underline\" data-kid=\"144\">Github</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"flex justify-between items-end font-mono text-[10px] uppercase opacity-40\" data-kid=\"145\">\n      <div data-kid=\"146\">© 2026 VideoTube Labs. All Rights Reserved.</div>\n      <div data-kid=\"147\">Designed in Switzerland / Built globally</div>\n    </div>\n  </footer>\n</div>\n\n<script type=\"module\" data-kid=\"148\">\n  import { animate, scroll, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // 1. Marquee Animation\n  const marquee = document.querySelector('.marquee-content');\n  animate(\n    marquee,\n    { x: [0, -marquee.scrollWidth / 2] },\n    { \n      duration: 30, \n      repeat: Infinity, \n      ease: \"linear\" \n    }\n  );\n\n  // 2. Feature Illustration Sync with Scroll\n  const illustration = document.getElementById('feature-illustration');\n  const featureSections = document.querySelectorAll('.w-full.md\\\\:w-1\\\\:2 > div');\n  \n  scroll(({ y }) => {\n    const progress = y.progress;\n    if (progress < 0.3) {\n      illustration.textContent = \"01\";\n    } else if (progress < 0.6) {\n      illustration.textContent = \"02\";\n    } else {\n      illustration.textContent = \"03\";\n    }\n  });\n\n  // 3. Entrance Animations\n  inView(\".font-serif\", (element) => {\n    animate(element, { opacity: [0, 1], y: [20, 0] }, { duration: 0.8, ease: \"easeOut\" });\n  });\n\n  inView(\"p\", (element) => {\n    animate(element, { opacity: [0, 1] }, { duration: 1.2, delay: 0.2 });\n  });\n</script>",
