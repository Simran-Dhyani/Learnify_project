      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-obsidian: #0A0A0C;\n    --accent-cyan: #00F0FF;\n    --accent-purple: #8A2BE2;\n    --text-primary: #FFFFFF;\n    --text-secondary: #A0A0A5;\n  }\n\n  body {\n    background-color: var(--bg-obsidian);\n    color: var(--text-primary);\n    font-family: 'Inter', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .font-space { font-family: 'Space Grotesk', sans-serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  .glass-panel {\n    background: rgba(26, 26, 30, 0.4);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(0, 240, 255, 0.15);\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);\n  }\n\n  .laser-border {\n    position: relative;\n    border: 1px solid transparent;\n    background-clip: padding-box;\n  }\n  .laser-border::after {\n    content: '';\n    position: absolute;\n    top: -1px; bottom: -1px; left: -1px; right: -1px;\n    background: linear-gradient(to bottom right, var(--accent-cyan), transparent 40%, transparent 60%, var(--accent-purple));\n    z-index: -1;\n    border-radius: inherit;\n    opacity: 0.3;\n  }\n\n  .light-leak {\n    position: fixed;\n    width: 60vw;\n    height: 60vw;\n    border-radius: 50%;\n    filter: blur(120px);\n    pointer-events: none;\n    z-index: -1;\n    opacity: 0.15;\n  }\n\n  .terminal-cursor {\n    display: inline-block;\n    width: 10px;\n    height: 1.2em;\n    background-color: var(--accent-cyan);\n    vertical-align: middle;\n    margin-left: 4px;\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    50% { opacity: 0; }\n  }\n\n  .glow-text {\n    text-shadow: 0 0 20px rgba(0, 240, 255, 0.4);\n  }\n\n  .folder-shape {\n    clip-path: polygon(0 0, 60% 0, 70% 15%, 100% 15%, 100% 100%, 0 100%);\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <div id=\"light-leak-1\" class=\"light-leak bg-[var(--accent-cyan)] -top-[20%] -left-[10%]\" data-kid=\"2\"></div>\n  <div id=\"light-leak-2\" class=\"light-leak bg-[var(--accent-purple)] -bottom-[20%] -right-[10%]\" data-kid=\"3\"></div>\n  \n  <div class=\"fixed inset-0 z-[-2] opacity-20 grayscale pointer-events-none\" data-kid=\"4\">\n    <video src=\"https://videos.pexels.com/video-files/37445973/15859691_640_360_24fps.mp4\" poster=\"https://images.pexels.com/videos/37445973/abstract-abstract-animation-abstract-background-animation-37445973.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline class=\"w-full h-full object-cover\" data-kid=\"5\"></video>\n  </div>\n\n  \n  <nav class=\"fixed top-0 w-full z-50 px-8 py-6 flex justify-between items-center bg-transparent backdrop-blur-md border-b border-white/5\" data-kid=\"6\">\n    <div class=\"flex items-center gap-2 group cursor-pointer\" data-kid=\"7\">\n      <div class=\"w-10 h-10 bg-gradient-to-br from-[var(--accent-cyan)] to-[var(--accent-purple)] rounded-lg flex items-center justify-center shadow-lg shadow-cyan-500/20\" data-kid=\"8\">\n        <i class=\"ti ti-play-circle text-2xl text-white\" data-kid=\"9\"></i>\n      </div>\n      <span class=\"text-2xl font-space font-bold tracking-tighter glow-text\" data-kid=\"10\">VideoTube</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-10 text-sm font-medium tracking-widest uppercase text-[var(--text-secondary)]\" data-kid=\"11\">\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"12\">Features</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"13\">Solutions</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"14\">Pricing</a>\n      <a href=\"#\" class=\"px-6 py-2 border border-white/20 rounded-full hover:bg-white hover:text-black transition-all\" data-kid=\"15\">Sign In</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-40 pb-20 px-4 flex flex-col items-center text-center\" data-kid=\"16\">\n    <div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-500/5 mb-8\" data-kid=\"17\">\n      <span class=\"w-2 h-2 rounded-full bg-[var(--accent-cyan)] animate-pulse\" data-kid=\"18\"></span>\n      <span class=\"text-[10px] uppercase tracking-[0.2em] font-mono text-[var(--accent-cyan)]\" data-kid=\"19\">V2.0 Now Available</span>\n    </div>\n    \n    <h1 class=\"massive-title font-space font-bold text-7xl md:text-9xl tracking-tight leading-[0.9] mb-8 max-w-5xl\" data-kid=\"20\">\n      Learn with <br data-kid=\"21\">\n      <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)]\" data-kid=\"22\">Intelligence</span>\n    </h1>\n    \n    <p class=\"text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mb-12 leading-relaxed\" data-kid=\"23\">\n      Transform your video learning experience with AI-powered smart notes, organized workflows, and intelligent insights.\n    </p>\n\n    <div class=\"flex flex-col sm:flex-row gap-6 mb-24\" data-kid=\"24\">\n      <button class=\"px-10 py-5 bg-[var(--accent-cyan)] text-black font-bold rounded-xl hover:scale-105 transition-transform flex items-center gap-3 group shadow-[0_0_30px_rgba(0,240,255,0.4)]\" data-kid=\"25\">\n        Get Started Free\n        <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"26\"></i>\n      </button>\n      <button class=\"px-10 py-5 bg-white/5 border border-white/10 text-white font-bold rounded-xl hover:bg-white/10 transition-colors flex items-center gap-3\" data-kid=\"27\">\n        Watch Demo\n        <i class=\"ti ti-player-play\" data-kid=\"28\"></i>\n      </button>\n    </div>\n\n    \n    <div id=\"hero-mockup\" class=\"relative w-full max-w-6xl mx-auto\" data-kid=\"29\">\n      <div class=\"glass-panel p-2 rounded-2xl laser-border overflow-hidden\" data-kid=\"30\">\n        <img src=\"https://images.unsplash.com/photo-1720962158789-9389a4f399da?auto=format&w=1200&q=80&fit=crop\" alt=\"Interface\" class=\"w-full rounded-xl opacity-90\" loading=\"lazy\" decoding=\"async\" data-kid=\"31\">\n        \n        \n        <div class=\"absolute -top-10 -right-10 glass-panel p-6 rounded-2xl w-64 text-left animate-float\" data-kid=\"32\">\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"33\">\n            <div class=\"w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center\" data-kid=\"34\">\n              <i class=\"ti ti-cpu text-[var(--accent-purple)]\" data-kid=\"35\"></i>\n            </div>\n            <div data-kid=\"36\">\n              <p class=\"text-xs text-[var(--text-secondary)]\" data-kid=\"37\">AI Insights</p>\n              <p class=\"text-sm font-bold\" data-kid=\"38\">Key topics extracted</p>\n            </div>\n          </div>\n          <div class=\"space-y-2\" data-kid=\"39\">\n            <div class=\"h-1.5 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"40\">\n              <div class=\"h-full w-[80%] bg-[var(--accent-purple)]\" data-kid=\"41\"></div>\n            </div>\n            <div class=\"h-1.5 w-[60%] bg-white/5 rounded-full overflow-hidden\" data-kid=\"42\">\n              <div class=\"h-full w-full bg-[var(--accent-cyan)]\" data-kid=\"43\"></div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"absolute -bottom-12 -left-12 glass-panel p-6 rounded-2xl flex items-center gap-4 animate-float-delayed\" data-kid=\"44\">\n          <div class=\"w-12 h-12 rounded-xl bg-cyan-500/20 flex items-center justify-center\" data-kid=\"45\">\n            <i class=\"ti ti-notes text-[var(--accent-cyan)] text-2xl\" data-kid=\"46\"></i>\n          </div>\n          <div data-kid=\"47\">\n            <p class=\"text-sm font-bold\" data-kid=\"48\">Smart Note Generated</p>\n            <p class=\"text-xs text-[var(--text-secondary)]\" data-kid=\"49\">Just now • Video timestamp 12:45</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"py-32 px-4 max-w-7xl mx-auto\" data-kid=\"50\">\n    <div class=\"text-center mb-24\" data-kid=\"51\">\n      <h2 class=\"font-space text-5xl md:text-6xl font-bold mb-6\" data-kid=\"52\">Redefining Education</h2>\n      <div class=\"w-24 h-1 bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] mx-auto\" data-kid=\"53\"></div>\n    </div>\n\n    \n    <div class=\"flex flex-col md:flex-row items-center gap-16 mb-40 feature-row\" data-kid=\"54\">\n      <div class=\"flex-1 order-2 md:order-1\" data-kid=\"55\">\n        <div class=\"inline-block px-4 py-1 rounded-full bg-purple-500/10 text-[var(--accent-purple)] font-mono text-xs mb-6 uppercase tracking-widest border border-purple-500/20\" data-kid=\"56\">01 / Innovation</div>\n        <h3 class=\"font-space text-4xl md:text-5xl font-bold mb-6\" data-kid=\"57\">AI Smart Notes</h3>\n        <p class=\"text-[var(--text-secondary)] text-lg mb-8 leading-relaxed\" data-kid=\"58\">\n          Never miss a beat. Our AI automatically transcribes your videos and extracts key concepts, formulas, and summaries in real-time. It's like having a genius TA watching every video with you.\n        </p>\n        <ul class=\"space-y-4 text-sm font-medium\" data-kid=\"59\">\n          <li class=\"flex items-center gap-3\" data-kid=\"60\"><i class=\"ti ti-circle-check text-[var(--accent-cyan)]\" data-kid=\"61\"></i> Automatic Timestamping</li>\n          <li class=\"flex items-center gap-3\" data-kid=\"62\"><i class=\"ti ti-circle-check text-[var(--accent-cyan)]\" data-kid=\"63\"></i> Concept Extraction</li>\n          <li class=\"flex items-center gap-3\" data-kid=\"64\"><i class=\"ti ti-circle-check text-[var(--accent-cyan)]\" data-kid=\"65\"></i> PDF/Notion Export</li>\n        </ul>\n      </div>\n      <div class=\"flex-1 order-1 md:order-2\" data-kid=\"66\">\n        <div class=\"relative group\" data-kid=\"67\">\n          <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--accent-purple)] to-[var(--accent-cyan)] rounded-2xl blur-2xl opacity-20 group-hover:opacity-40 transition-opacity\" data-kid=\"68\"></div>\n          <div class=\"relative glass-panel rounded-2xl p-4 laser-border aspect-video flex items-center justify-center\" data-kid=\"69\">\n            <img src=\"https://images.pexels.com/photos/27141314/pexels-photo-27141314.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" alt=\"Smart Notes\" class=\"w-full h-full object-cover rounded-xl opacity-80\" loading=\"lazy\" decoding=\"async\" data-kid=\"70\">\n            <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"71\">\n              <div class=\"w-20 h-20 bg-white/10 backdrop-blur-xl border border-white/20 rounded-full flex items-center justify-center cursor-pointer hover:scale-110 transition-transform\" data-kid=\"72\">\n                <i class=\"ti ti-player-play text-3xl\" data-kid=\"73\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"flex flex-col md:flex-row items-center gap-16 feature-row\" data-kid=\"74\">\n      <div class=\"flex-1\" data-kid=\"75\">\n        <div class=\"relative group\" data-kid=\"76\">\n          <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--accent-cyan)] to-[var(--accent-purple)] rounded-2xl blur-2xl opacity-20 group-hover:opacity-40 transition-opacity\" data-kid=\"77\"></div>\n          <div class=\"relative glass-panel rounded-2xl p-4 laser-border aspect-video overflow-hidden\" data-kid=\"78\">\n            <div class=\"absolute top-4 left-4 flex gap-2\" data-kid=\"79\">\n              <div class=\"w-3 h-3 rounded-full bg-red-500/50\" data-kid=\"80\"></div>\n              <div class=\"w-3 h-3 rounded-full bg-yellow-500/50\" data-kid=\"81\"></div>\n              <div class=\"w-3 h-3 rounded-full bg-green-500/50\" data-kid=\"82\"></div>\n            </div>\n            <img src=\"https://images.pexels.com/photos/27141316/pexels-photo-27141316.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" alt=\"Video Learning\" class=\"w-full h-full object-cover rounded-xl opacity-80\" loading=\"lazy\" decoding=\"async\" data-kid=\"83\">\n          </div>\n        </div>\n      </div>\n      <div class=\"flex-1\" data-kid=\"84\">\n        <div class=\"inline-block px-4 py-1 rounded-full bg-cyan-500/10 text-[var(--accent-cyan)] font-mono text-xs mb-6 uppercase tracking-widest border border-cyan-500/20\" data-kid=\"85\">02 / Workflow</div>\n        <h3 class=\"font-space text-4xl md:text-5xl font-bold mb-6\" data-kid=\"86\">Deep Focus Learning</h3>\n        <p class=\"text-[var(--text-secondary)] text-lg mb-8 leading-relaxed\" data-kid=\"87\">\n          Our distraction-free interface puts the video and your notes front-and-center. Intelligent playback controls and split-screen editing make the learning flow state effortless.\n        </p>\n        <ul class=\"space-y-4 text-sm font-medium\" data-kid=\"88\">\n          <li class=\"flex items-center gap-3\" data-kid=\"89\"><i class=\"ti ti-circle-check text-[var(--accent-purple)]\" data-kid=\"90\"></i> Focus Mode</li>\n          <li class=\"flex items-center gap-3\" data-kid=\"91\"><i class=\"ti ti-circle-check text-[var(--accent-purple)]\" data-kid=\"92\"></i> Split-Screen Workspace</li>\n          <li class=\"flex items-center gap-3\" data-kid=\"93\"><i class=\"ti ti-circle-check text-[var(--accent-purple)]\" data-kid=\"94\"></i> Keyboard-Driven Shortcuts</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-4 bg-white/[0.02] border-y border-white/5\" data-kid=\"95\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"96\">\n      <div class=\"flex flex-col md:flex-row justify-between items-end mb-16 gap-6\" data-kid=\"97\">\n        <div class=\"max-w-xl\" data-kid=\"98\">\n          <h2 class=\"font-space text-4xl md:text-5xl font-bold mb-4\" data-kid=\"99\">Total Organization</h2>\n          <p class=\"text-[var(--text-secondary)] text-lg\" data-kid=\"100\">Group your learning materials into intelligent folders that automatically categorize content based on topic and AI analysis.</p>\n        </div>\n        <button class=\"text-[var(--accent-cyan)] font-mono text-xs uppercase tracking-widest flex items-center gap-2 group\" data-kid=\"101\">\n          Explore System <i class=\"ti ti-arrow-up-right group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\" data-kid=\"102\"></i>\n        </button>\n      </div>\n\n      \n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\" data-kid=\"103\">\n        \n        <div class=\"group relative flex flex-col h-72\" data-kid=\"104\">\n          <div class=\"absolute inset-0 bg-[var(--accent-cyan)] blur-2xl opacity-0 group-hover:opacity-10 transition-opacity\" data-kid=\"105\"></div>\n          <div class=\"folder-shape glass-panel flex-1 p-8 flex flex-col justify-between group-hover:-translate-y-2 transition-transform cursor-pointer relative overflow-hidden\" data-kid=\"106\">\n            <div class=\"absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-20 transition-opacity\" data-kid=\"107\">\n               <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/nested-hexagons.svg\" class=\"w-32 h-32 text-cyan-500\" data-kid=\"108\">\n            </div>\n            <div class=\"w-12 h-12 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6\" data-kid=\"109\">\n              <i class=\"ti ti-folder-open text-2xl text-[var(--accent-cyan)]\" data-kid=\"110\"></i>\n            </div>\n            <div data-kid=\"111\">\n              <p class=\"font-mono text-[10px] text-[var(--text-secondary)] mb-1\" data-kid=\"112\">08 VIDEOS</p>\n              <h4 class=\"text-xl font-bold font-space\" data-kid=\"113\">Quantum Computing</h4>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group relative flex flex-col h-72 lg:translate-y-8\" data-kid=\"114\">\n           <div class=\"absolute inset-0 bg-[var(--accent-purple)] blur-2xl opacity-0 group-hover:opacity-10 transition-opacity\" data-kid=\"115\"></div>\n          <div class=\"folder-shape glass-panel flex-1 p-8 flex flex-col justify-between group-hover:-translate-y-2 transition-transform cursor-pointer relative overflow-hidden\" data-kid=\"116\">\n            <div class=\"w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center mb-6\" data-kid=\"117\">\n              <i class=\"ti ti-folder-open text-2xl text-[var(--accent-purple)]\" data-kid=\"118\"></i>\n            </div>\n            <div data-kid=\"119\">\n              <p class=\"font-mono text-[10px] text-[var(--text-secondary)] mb-1\" data-kid=\"120\">12 VIDEOS</p>\n              <h4 class=\"text-xl font-bold font-space\" data-kid=\"121\">Neural Networks</h4>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group relative flex flex-col h-72\" data-kid=\"122\">\n          <div class=\"absolute inset-0 bg-white blur-2xl opacity-0 group-hover:opacity-10 transition-opacity\" data-kid=\"123\"></div>\n          <div class=\"folder-shape glass-panel flex-1 p-8 flex flex-col justify-between group-hover:-translate-y-2 transition-transform cursor-pointer relative overflow-hidden\" data-kid=\"124\">\n            <div class=\"w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center mb-6\" data-kid=\"125\">\n              <i class=\"ti ti-folder-open text-2xl text-white\" data-kid=\"126\"></i>\n            </div>\n            <div data-kid=\"127\">\n              <p class=\"font-mono text-[10px] text-[var(--text-secondary)] mb-1\" data-kid=\"128\">05 VIDEOS</p>\n              <h4 class=\"text-xl font-bold font-space\" data-kid=\"129\">User Experience</h4>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group relative flex flex-col h-72 lg:translate-y-8\" data-kid=\"130\">\n          <div class=\"absolute inset-0 bg-[var(--accent-cyan)] blur-2xl opacity-0 group-hover:opacity-10 transition-opacity\" data-kid=\"131\"></div>\n          <div class=\"folder-shape glass-panel flex-1 p-8 flex flex-col justify-between group-hover:-translate-y-2 transition-transform cursor-pointer relative overflow-hidden\" data-kid=\"132\">\n            <div class=\"w-12 h-12 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6\" data-kid=\"133\">\n              <i class=\"ti ti-folder-open text-2xl text-[var(--accent-cyan)]\" data-kid=\"134\"></i>\n            </div>\n            <div data-kid=\"135\">\n              <p class=\"font-mono text-[10px] text-[var(--text-secondary)] mb-1\" data-kid=\"136\">24 VIDEOS</p>\n              <h4 class=\"text-xl font-bold font-space\" data-kid=\"137\">System Design</h4>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 px-4\" data-kid=\"138\">\n    <div class=\"max-w-4xl mx-auto\" data-kid=\"139\">\n      <div class=\"bg-black/80 rounded-2xl border border-white/10 shadow-2xl overflow-hidden font-mono text-sm\" data-kid=\"140\">\n        <div class=\"bg-white/5 px-6 py-3 flex items-center justify-between border-b border-white/10\" data-kid=\"141\">\n          <div class=\"flex gap-2\" data-kid=\"142\">\n            <div class=\"w-3 h-3 rounded-full bg-red-500/30\" data-kid=\"143\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-yellow-500/30\" data-kid=\"144\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-green-500/30\" data-kid=\"145\"></div>\n          </div>\n          <p class=\"text-xs text-[var(--text-secondary)]\" data-kid=\"146\">bash — video-tube.sh</p>\n          <div class=\"w-10\" data-kid=\"147\"></div>\n        </div>\n        <div class=\"p-10\" data-kid=\"148\">\n          <p class=\"text-[var(--accent-cyan)] mb-2\" data-kid=\"149\">$ deploy --platform=videotube --mode=future</p>\n          <p class=\"text-white/60 mb-6\" data-kid=\"150\">Initializing learning core...</p>\n          <div class=\"text-2xl md:text-4xl font-space font-bold text-white mb-10 leading-tight\" data-kid=\"151\">\n            Ready to upgrade your <br data-kid=\"152\">\n            intellectual bandwidth? <span class=\"terminal-cursor\" data-kid=\"153\"></span>\n          </div>\n          <div class=\"flex flex-col sm:flex-row gap-6\" data-kid=\"154\">\n            <button class=\"px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-[var(--accent-cyan)] transition-colors\" data-kid=\"155\">\n              Initialize Account\n            </button>\n            <button class=\"px-8 py-4 border border-white/10 hover:bg-white/5 transition-colors\" data-kid=\"156\">\n              Access Documentation\n            </button>\n          </div>\n          <p class=\"mt-8 text-[var(--text-secondary)] text-xs\" data-kid=\"157\">Waiting for user input...</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-8 border-t border-white/5 bg-black/50\" data-kid=\"158\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"159\">\n      <div class=\"md:col-span-1\" data-kid=\"160\">\n        <div class=\"flex items-center gap-2 mb-6\" data-kid=\"161\">\n          <div class=\"w-8 h-8 bg-gradient-to-br from-[var(--accent-cyan)] to-[var(--accent-purple)] rounded flex items-center justify-center\" data-kid=\"162\">\n            <i class=\"ti ti-play-circle text-white\" data-kid=\"163\"></i>\n          </div>\n          <span class=\"text-xl font-space font-bold tracking-tighter\" data-kid=\"164\">VideoTube</span>\n        </div>\n        <p class=\"text-xs text-[var(--text-secondary)] leading-loose\" data-kid=\"165\">\n          Next-gen video learning platform powered by machine intelligence. Designed for the builders of tomorrow.\n        </p>\n      </div>\n      <div data-kid=\"166\">\n        <h5 class=\"text-xs font-mono uppercase tracking-widest mb-8 text-white\" data-kid=\"167\">Platform</h5>\n        <ul class=\"space-y-4 text-xs text-[var(--text-secondary)]\" data-kid=\"168\">\n          <li data-kid=\"169\"><a href=\"#\" class=\"hover:text-[var(--accent-cyan)] transition-colors\" data-kid=\"170\">Architecture</a></li>\n          <li data-kid=\"171\"><a href=\"#\" class=\"hover:text-[var(--accent-cyan)] transition-colors\" data-kid=\"172\">Security</a></li>\n          <li data-kid=\"173\"><a href=\"#\" class=\"hover:text-[var(--accent-cyan)] transition-colors\" data-kid=\"174\">API Docs</a></li>\n          <li data-kid=\"175\"><a href=\"#\" class=\"hover:text-[var(--accent-cyan)] transition-colors\" data-kid=\"176\">Uptime</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"177\">\n        <h5 class=\"text-xs font-mono uppercase tracking-widest mb-8 text-white\" data-kid=\"178\">Community</h5>\n        <ul class=\"space-y-4 text-xs text-[var(--text-secondary)]\" data-kid=\"179\">\n          <li data-kid=\"180\"><a href=\"#\" class=\"hover:text-[var(--accent-purple)] transition-colors\" data-kid=\"181\">Discord</a></li>\n          <li data-kid=\"182\"><a href=\"#\" class=\"hover:text-[var(--accent-purple)] transition-colors\" data-kid=\"183\">Twitter</a></li>\n          <li data-kid=\"184\"><a href=\"#\" class=\"hover:text-[var(--accent-purple)] transition-colors\" data-kid=\"185\">GitHub</a></li>\n          <li data-kid=\"186\"><a href=\"#\" class=\"hover:text-[var(--accent-purple)] transition-colors\" data-kid=\"187\">Changelog</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"188\">\n        <h5 class=\"text-xs font-mono uppercase tracking-widest mb-8 text-white\" data-kid=\"189\">Newsletter</h5>\n        <div class=\"relative\" data-kid=\"190\">\n          <input type=\"email\" placeholder=\"Email Address\" class=\"w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-xs focus:outline-none focus:border-[var(--accent-cyan)] transition-colors\" data-kid=\"191\">\n          <button class=\"absolute right-2 top-2 bottom-2 px-4 bg-white/10 hover:bg-white/20 rounded-md transition-colors\" data-kid=\"192\">\n            <i class=\"ti ti-arrow-right\" data-kid=\"193\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto mt-20 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"194\">\n      <p class=\"text-[10px] font-mono text-white/20\" data-kid=\"195\">© 2026 VIDEOTUBE_LABS. ALL RIGHTS RESERVED.</p>\n      <div class=\"flex gap-8 text-[10px] font-mono text-white/20 uppercase tracking-widest\" data-kid=\"196\">\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"197\">Terms</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"198\">Privacy</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"199\">Legal</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"200\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"201\"></script>\n<script data-kid=\"202\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Background light leak movement\n  gsap.to(\"#light-leak-1\", {\n    x: \"20vw\",\n    y: \"10vh\",\n    duration: 15,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  gsap.to(\"#light-leak-2\", {\n    x: \"-20vw\",\n    y: \"-10vh\",\n    duration: 12,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  // Hero animations\n  const heroTl = gsap.timeline();\n  heroTl.from(\"h1\", { opacity: 0, y: 50, duration: 1.2, ease: \"power4.out\" })\n        .from(\"h1 span\", { scale: 0.9, duration: 1, ease: \"back.out(1.7)\" }, \"-=0.8\")\n        .from(\"p\", { opacity: 0, y: 20, duration: 1 }, \"-=0.6\")\n        .from(\"button\", { opacity: 0, y: 20, duration: 1, stagger: 0.1 }, \"-=0.8\")\n        .from(\"#hero-mockup\", { opacity: 0, scale: 0.95, y: 40, duration: 1.5, ease: \"power3.out\" }, \"-=1\");\n\n  // Floating mockup elements\n  gsap.to(\".animate-float\", {\n    y: -20,\n    duration: 3,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  gsap.to(\".animate-float-delayed\", {\n    y: 20,\n    duration: 3.5,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\",\n    delay: 0.5\n  });\n\n  // Feature row reveals\n  gsap.utils.toArray(\".feature-row\").forEach((row, i) => {\n    gsap.from(row.querySelectorAll(\".flex-1\"), {\n      scrollTrigger: {\n        trigger: row,\n        start: \"top 80%\",\n        toggleActions: \"play none none reverse\"\n      },\n      opacity: 0,\n      x: (index) => index === 0 ? -50 : 50,\n      duration: 1.2,\n      stagger: 0.2,\n      ease: \"power3.out\"\n    });\n  });\n\n  // Folder grid hover effects (stagger reveal)\n  gsap.from(\".group\", {\n    scrollTrigger: {\n      trigger: \".grid\",\n      start: \"top 85%\"\n    },\n    opacity: 0,\n    y: 40,\n    stagger: 0.1,\n    duration: 1,\n    ease: \"power3.out\"\n  });\n</script>",
